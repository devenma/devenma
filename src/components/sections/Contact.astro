---
/**
 * Contact.astro — Links-only contact section.
 *
 * id="contact". Short invite line + SocialLinks (mailto prefilled subject,
 * GitHub, LinkedIn) with pixel icons. NO form, NO backend, NO extra JS.
 * Large tap targets (≥44px from SocialLinks).
 */

import { socialLinks } from '../../data/social';
import SectionHeading from '../ui/SectionHeading.astro';
import SocialLinks from '../ui/SocialLinks.astro';
---

<section id="contact" class="px-4 py-24 sm:px-6">
  <div class="mx-auto max-w-3xl space-y-10 text-center">
    <SectionHeading
      eyebrow="Contacto"
      title="Contact"
    />

    <p class="text-lg text-text-muted leading-relaxed">
      Si querés conversar sobre desarrollo web, colaborar en un proyecto o
      simplemente conectar, podés encontrarme en cualquiera de estos canales.
    </p>

    <div class="flex justify-center pt-4">
      <SocialLinks links={socialLinks} class="gap-8" />
    </div>
  </div>
</section>
