---
/**
 * About.astro — Short professional profile section.
 *
 * id="about". 2-3 paragraphs covering 6 AGENTS.md positioning points:
 * ~3y experience, Drupal/PHP/JS specialization, Astro/TS/Tailwind evolution,
 * frontend interest, UI/UX importance, independent projects.
 * Avoids banned corporate phrases. NOT a CV repeat.
 */

import SectionHeading from "../ui/SectionHeading.astro";
import { skillGroups, type SkillWeight } from "../../data/skills";

const weightToTextSize: Record<SkillWeight, string> = {
  core: "text-xl",
  working: "text-base",
  additional: "text-sm",
};

const weightToColor: Record<SkillWeight, string> = {
  core: "text-text",
  working: "text-text-muted",
  additional: "text-text-subtle",
};

const weightToSeparator: Record<SkillWeight, string> = {
  core: "text-text-muted",
  working: "text-text-subtle",
  additional: "text-text-subtle/50",
};
---

<section id="about" class="px-4 py-18 sm:px-6 min-h-screen flex max-xl:flex-col gap-10">
  <div class="mx-auto max-w-3xl space-y-10">
    <SectionHeading eyebrow="hn-user" title="Sobre mí" />

    <div class="prose space-y-4 text-base text-text-muted leading-relaxed">
      <p>
        Soy desarrollador web con aproximadamente 3 años de experiencia
        profesional trabajando en aplicaciones reales en producción. Mi base
        está en PHP, JavaScript, HTML y CSS, con una especialización sólida en
        Drupal — desde versiones legacy como Drupal 7 hasta las más recientes
        Drupal 10 y 11.
      </p>

      <p>
        En paralelo, estoy evolucionando mi stack hacia tecnologías frontend
        modernas: desarrollo proyectos con <strong class="text-text"
          >Astro, TypeScript y Tailwind CSS</strong
        >, aplicando conceptos de diseño responsive, componentes reutilizables y
        performance. También tengo experiencia complementaria con Vue, Tauri y
        Rust.
      </p>

      <p>
        Me importa especialmente la calidad visual de las interfaces y la
        experiencia de usuario. Para mí, una aplicación no solo debe funcionar
        correctamente: tiene que verse bien, sentirse consistente y ser clara de
        usar en cualquier dispositivo.
      </p>
    </div>
  </div>
  <div class="mx-auto max-w-3xl space-y-6">
    <SectionHeading
      eyebrow="hn-code-block"
      title="Skills"
    />

    <div class="space-y-8">
      {skillGroups.map((group) => (
        <div class="space-y-2">
          <!-- Group label — Geist Pixel eyebrow (matches SectionHeading convention) -->
          <h3 class="font-display text-sm tracking-widest text-accent uppercase">
            {group.label}
          </h3>

          <!-- Technologies inline with middot separator -->
          <p class={`${weightToTextSize[group.weight]} ${weightToColor[group.weight]} leading-relaxed`}>
            {group.technologies.map((tech, i) => (
              <span>
                {tech}
                {i < group.technologies.length - 1 && (
                  <span class={`mx-1.5 select-none ${weightToSeparator[group.weight]}`} aria-hidden="true">
                    &middot;
                  </span>
                )}
              </span>
            ))}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
