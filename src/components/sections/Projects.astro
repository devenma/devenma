---
/**
 * Projects.astro — Project cards in fixed order with status badges,
 * monogram placeholders, tech chips, and links (TODO where missing).
 *
 * id="projects". Grid: 1 col mobile, 2 col tablet, 3 col desktop.
 * State truthfulness maintained from data — never presents in-development as production.
 */

import { projects } from '../../data/projects';
import SectionHeading from '../ui/SectionHeading.astro';
import Badge from '../ui/Badge.astro';
import Card from '../ui/Card.astro';
import { Image } from 'astro:assets';
---

<section id="projects" class="px-4 py-18 sm:px-6 min-h-screen">
  <div class="mx-auto max-w-6xl space-y-12">
    <SectionHeading
      eyebrow="hn-code"
      title="Proyectos"
    />

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <Card class="flex flex-col gap-4 group">
          <!-- Images - monogram placeholder -->
          {project.images ? (
            <div class="rounded-t-xl overflow-hidden">
              <Image width="640" height="480" alt={project.name} class="dark group-hover:scale-105 transition-transform ease-in-out duration-500" src={project.images.dark}/>
              <Image width="640" height="480" alt={project.name} class="light group-hover:scale-105 transition-transform ease-in-out duration-500" src={project.images.light}/>
            </div>
          ) : (
            <div
              class="flex h-20 w-20 shrink-0 items-center justify-center rounded-lg border border-border bg-accent-soft mt-6 ml-6"
              aria-hidden="true"
            >
              <span class="font-display text-xl text-accent">
                {project.monogram}
              </span>
            </div>
            )}

          <!-- Name + status -->
          <div class="flex items-start justify-between gap-2 px-6">
            <h3 class="font-display text-lg text-text leading-tight">
              {project.name}
            </h3>
            <Badge tone={project.status} />
          </div>

          <!-- Description -->
          <p class="text-sm text-text-muted leading-relaxed flex-1 px-6">
            {project.description}
          </p>

          <!-- Technology chips -->
          {project.technologies.length > 0 && (
            <div class="flex flex-wrap gap-1.5 px-6">
              {project.technologies.map((tech) => (
                <span class="inline-flex items-center rounded border border-border bg-surface px-2 py-0.5 font-mono text-xs text-text-muted">
                  {tech}
                </span>
              ))}
            </div>
          )}

          <!--Links -->
          <div class="mt-auto pt-2 px-6 pb-6">
            {project.links && project.links.length > 0 ? (
              <div class="flex items-center gap-4">
                {project.links.map((link) => (
                  <Fragment>
                    {link.todo ? (
                      <span class="font-mono text-xs text-text-subtle italic">
                        {link.label} — TODO
                      </span>
                    ) : (
                      <a
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-display px-3 py-1.5 rounded-full border border-border bg-bg-elevated flex gap-2 items-center text-xs duration-300 hover:shadow-md hover:text-accent transition"
                        >
                        {link.type == 'code' ? (
                          <i class="hn hn-github"></i>
                        ) : (
                          <i class="hn hn-external-link-solid"></i>
                        )}
                        {link.label}
                      </a>
                    )}
                  </Fragment>
                ))}
              </div>
            ) : (
              <p class="font-mono text-xs text-text-subtle italic">
                Enlaces próximamente
              </p>
            )}
          </div>
        </Card>
      ))}
    </div>
  </div>
</section>
