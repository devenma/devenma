---
/**
 * Skills.astro — Technology stack grouped by domain with visual hierarchy.
 *
 * id="skills". 5 groups from skills.ts. Hierarchy via typography only:
 * core (text-xl, text-text), working (text-base, text-text-muted),
 * additional (text-sm, text-text-subtle). NO bars, NO percentages.
 */

import { skillGroups, type SkillWeight } from '../../data/skills';
import SectionHeading from '../ui/SectionHeading.astro';

const weightToTextSize: Record<SkillWeight, string> = {
  core: 'text-xl',
  working: 'text-base',
  additional: 'text-sm',
};

const weightToColor: Record<SkillWeight, string> = {
  core: 'text-text',
  working: 'text-text-muted',
  additional: 'text-text-subtle',
};

const weightToSeparator: Record<SkillWeight, string> = {
  core: 'text-text-muted',
  working: 'text-text-subtle',
  additional: 'text-text-subtle/50',
};
---

<section id="skills" class="px-4 py-24 sm:px-6">
  <div class="mx-auto max-w-3xl space-y-12">
    <SectionHeading
      eyebrow="Stack"
      title="Skills"
    />

    <div class="space-y-8">
      {skillGroups.map((group) => (
        <div class="space-y-2">
          <!-- Group label — Geist Pixel eyebrow (matches SectionHeading convention) -->
          <h3 class="font-display text-sm tracking-widest text-accent uppercase">
            {group.label}
          </h3>

          <!-- Technologies inline with middot separator -->
          <p class={`${weightToTextSize[group.weight]} ${weightToColor[group.weight]} leading-relaxed`}>
            {group.technologies.map((tech, i) => (
              <span>
                {tech}
                {i < group.technologies.length - 1 && (
                  <span class={`mx-1.5 select-none ${weightToSeparator[group.weight]}`} aria-hidden="true">
                    &middot;
                  </span>
                )}
              </span>
            ))}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
