---
/**
 * BaseHead.astro — Standard SEO head elements for every page.
 *
 * Expects site and profile data to be passed as props.
 */

import { site } from "../../data/site";
import { profile } from "../../data/profile";

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = site.title,
  description = site.description,
  ogImage = "/og.png", // TODO: create real OG image
} = Astro.props;

const canonicalUrl = site.url; // TODO: replace with real domain
---

<!-- Primary Meta -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="description" content={description} />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<!-- TODO: create custom favicon.svg with Enmanuel's identity -->

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={`${canonicalUrl}${ogImage}`} />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={`${canonicalUrl}${ogImage}`} />

<!-- Canonical (placeholder — replace when real domain is set) -->
<link rel="canonical" href={canonicalUrl} />

<!-- Geist sans preload (body font, woff2 latin-subset) -->
<link
  rel="preload"
  href="/fonts/Geist-Variable.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>

<!-- Person JSON-LD -->
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    name: profile.name,
    jobTitle: profile.role,
    url: canonicalUrl, // TODO: replace with real domain
    sameAs: [profile.github, profile.linkedin],
    email: profile.email,
  })}
/>
