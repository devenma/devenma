---
/**
 * SocialLinks.astro — Row of social/contact icon links.
 *
 * Props:
 *   links  — SocialLink[] from src/data/social.ts
 *   class? — additional classes for the container
 */

import Icon from "./Icon.astro";
import type { IconName } from "./Icon.astro";

interface SocialLink {
  label: string;
  href: string;
  icon: IconName;
  ariaLabel: string;
}

interface Props {
  links: SocialLink[];
  class?: string;
}

const { links, class: className } = Astro.props;
---

<ul class:list={["flex flex-wrap items-center gap-4", className]}>
  {
    links.map((link) => (
      <li>
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={link.ariaLabel}
          class="inline-flex items-center gap-2 text-text-muted transition-colors hover:text-accent"
        >
          <Icon
            class="transition-transform hover:scale-105"
            name={link.icon}
            size={24}
            decorative
          />
        </a>
      </li>
    ))
  }
</ul>
