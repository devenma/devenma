---
/**
 * SocialLinks.astro — Row of social/contact icon links.
 *
 * Props:
 *   links  — SocialLink[] from src/data/social.ts
 *   class? — additional classes for the container
 */

import type { SocialLink } from "../../data/social";

interface Props {
  links: SocialLink[];
  class?: string;
}

const { links, class: className } = Astro.props;
---

<ul
  class:list={["flex flex-wrap items-center max-sm:text-xs gap-4", className]}
>
  {
    links.map((link) => (
      <li>
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={link.ariaLabel}
          class="inline-flex font-display items-center gap-2 text-text-muted transition hover:scale-105 hover:text-accent"
        >
          <i class:list={["text-xl hn", link.icon]} />
          <span>{link.label}</span>
        </a>
      </li>
    ))
  }
</ul>
