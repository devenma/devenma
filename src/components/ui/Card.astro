---
/**
 * Card.astro — Surface container with border and hover lift.
 *
 * Props:
 *   as?   — HTML element (default: 'div')
 *   href? — if set, renders as <a> (link card)
 */

const { as, href, class: className } = Astro.props;

const baseClasses =
  'block rounded-xl border border-border bg-surface p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-text-muted';

const combinedClass = [baseClasses, className].filter(Boolean).join(' ');

const Tag = href ? 'a' : (as ?? 'div');
const extra = href ? { href, rel: 'noopener noreferrer' } : {};
---

<Tag class={combinedClass} {...extra}>
  <slot />
</Tag>
