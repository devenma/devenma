---
/**
 * SectionHeading.astro — Eyebrow + section title with anchor.
 *
 * Props:
 *   eyebrow? — small label above the heading (Geist Pixel display)
 *   title    — h2 heading text (Geist Pixel display)
 *   id?      — anchor id (also set as section[id] scroll-margin target)
 */

interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
  class?: string;
}

const { eyebrow, title, id, class: className } = Astro.props;
---

<div class:list={["space-y-2", className]}>
  <h2 id={id} class="font-display text-accent text-h2">
    {
      eyebrow && (
        <i
          class:list={[
            "hn mr-4 font-display text-text tracking-widest uppercase",
            eyebrow,
          ]}
        />
      )
    }
    {title}
  </h2>
</div>
