---
/**
 * Icon.astro — Zero-JS icon component consuming @hackernoon/pixel-icon-library SVGs.
 *
 * Imports raw SVG content via Vite `?raw`, strips the XML prolog and outer <svg> tags,
 * and injects only the inner shapes into a controlled <svg> element.
 *
 * Props:
 *   name       — icon identifier (github | linkedin | envelope)
 *   class?     — additional CSS classes
 *   ariaLabel? — accessible label (required for icon-only links)
 *   decorative — if true, sets aria-hidden (default: false)
 *   size?      — icon size in px (default: 24)
 */

import githubRaw from '@hackernoon/pixel-icon-library/icons/SVG/brands/github.svg?raw';
import linkedinRaw from '@hackernoon/pixel-icon-library/icons/SVG/brands/linkedin.svg?raw';
import envelopeRaw from '@hackernoon/pixel-icon-library/icons/SVG/regular/envelope.svg?raw';

export type IconName = 'github' | 'linkedin' | 'envelope';

interface Props {
  name: IconName;
  class?: string;
  ariaLabel?: string;
  decorative?: boolean;
  size?: number;
}

const { name, class: className, ariaLabel, decorative = false, size = 24 } = Astro.props;

const rawSvgs: Record<IconName, string> = {
  github: githubRaw,
  linkedin: linkedinRaw,
  envelope: envelopeRaw,
};

const raw = rawSvgs[name];

// Strip XML prolog <?xml ...?>, then extract inner content between <svg ...> and </svg>
const withoutProlog = raw.replace(/<\?xml[^?]*\?>/, '');
const match = withoutProlog.match(/<svg[^>]*>([\s\S]*)<\/svg>/);
const innerShapes = match ? match[1].trim() : '';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="currentColor"
  class={className}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={!decorative ? (ariaLabel ?? name) : undefined}
  role={!decorative ? 'img' : undefined}
  set:html={innerShapes}
/>
