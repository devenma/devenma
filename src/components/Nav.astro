---
/**
 * Nav.astro — Sticky top navigation with smooth-scroll anchors.
 *
 * Desktop: monogram "ER" left + in-page anchor links right (font-mono small).
 * Mobile: native <details>/<summary> disclosure menu (zero JS).
 *
 * Accessible: <nav aria-label="…">, focus-visible rings from global.css.
 */
const navLinks = [
  { label: "Experiencia", href: "#experience" },
  { label: "Proyectos", href: "#projects" },
  { label: "Sobre mí", href: "#about" },
  { label: "Contacto", href: "#contact" },
];
---

<header
  class="sticky top-4 z-50 border-b border-border bg-bg-elevated/90 backdrop-blur-sm w-fit mx-4 sm:mx-auto rounded-4xl shadow-sm"
>
  <nav
    aria-label="Navegación principal"
    class="mx-auto flex max-w-6xl items-center justify-between px-4 py-2 sm:px-6"
  >
    <!-- Monogram / home link -->
    <a
      href="#home"
      class="font-display text-lg mr-12 text-text no-underline hover:text-accent transition-colors"
      aria-label="Ir al inicio"
    >
      devenma
    </a>

    <!-- Desktop nav links -->
    <ul class="hidden sm:flex items-center gap-6">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="font-mono text-sm text-text-muted no-underline transition-colors hover:text-accent"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Mobile disclosure menu (zero JS) -->
    <details class="sm:hidden group">
      <summary
        class="flex cursor-pointer list-none items-center justify-center rounded-lg p-1 text-text-muted hover:text-accent transition-colors"
        aria-label="Abrir menú de navegación"
      >
        <!-- Hamburger icon (pure SVG, no JS) -->
        <i class="text-xl hn hn-bars"></i>
      </summary>
      <ul
        class="absolute right-4 top-full mt-2 rounded-lg border border-border bg-bg-elevated p-3 shadow-lg space-y-2 min-w-40"
      >
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="block rounded-md px-3 py-2 font-mono text-sm text-text-muted no-underline transition-colors hover:bg-surface hover:text-accent"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </nav>
</header>
